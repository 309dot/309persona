# OpenAI-compatible endpoint (default: Ollama local)
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:32b
OPENAI_FALLBACK_MODEL=qwen3:32b
# legacy(기본): 검색 + 품질 게이트 재호출 / direct: 지식베이스 전체 + 1회 호출 스트리밍
# 바꾸기 전에 backend/evals로 두 방식을 비교한다 (evals/README.md)
ANSWER_PIPELINE=legacy
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.4
LLM_MAX_OUTPUT_TOKENS=1200
# 스트리밍 응답에 토큰 사용량 요청(stream_options). 지원하지 않는 서버면 false
LLM_STREAM_USAGE=true
# direct 파이프라인이 모델에 다시 보내는 직전 질문·답변 쌍 수
CHAT_HISTORY_TURNS=3
ANSWER_TIME_BUDGET_SECONDS=90
RAG_TOP_K=4
RAG_MODE=lexical
RAG_VECTOR_WEIGHT=0.7
RAG_LEXICAL_WEIGHT=0.3
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
RAG_EMBEDDING_API_KEY=ollama
DATABASE_URL=
ANSWER_QUALITY_MODE=balanced

FIREBASE_CREDENTIALS_PATH=../serviceAccountKey.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
ALLOWED_ORIGINS=http://localhost:5173,https://www.309designlab.com,https://309designlab.com
ALLOWED_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?309designlab\.com$|^http://(localhost|127\.0\.0\.1)(:\d+)?$
KNOWLEDGE_PACK_PATH=../knowledge_base/309_knowledge_pack.json
MAX_SESSION_QUESTIONS=5
SESSION_WINDOW_MINUTES=30
# 같은 IP의 질문·새 세션 수 제한(IP_WINDOW_MINUTES 동안). 서버 메모리에만 있어 재배포하면 초기화된다
MAX_IP_QUESTIONS=30
MAX_IP_SESSIONS=20
IP_WINDOW_MINUTES=60
# 앱 앞단에서 X-Forwarded-For를 덧붙이는 프록시 수(Render 1, staging의 nginx 1). 0이면 헤더를 무시
TRUSTED_PROXY_HOPS=1
ADMIN_ALLOWED_EMAILS=me@example.com
# 비어 있으면 대시보드 접근이 모두 막힌다. 관리자 Firebase 계정이 이메일 인증을 마쳤다면 true 권장
ADMIN_REQUIRE_EMAIL_VERIFIED=false
ENVIRONMENT=local

