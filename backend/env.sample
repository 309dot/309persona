# 모델 순서: Gemini(GEMINI_API_KEY) → OpenAI 호환 서버(OPENAI_*) → Claude(ANTHROPIC_API_KEY 또는 CLAUDE_API_KEY).
# 다음 모델로는 첫 글자가 나가기 전에 실패했을 때만 넘어간다. 변수 이름은 대소문자를 가리지 않는다.

# Google Gemini (AI Studio 키, docs/deployment.md "LLM 연결"). 비우면 쓰지 않는다
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini 3는 생각을 끌 수 없다. 추론 강도(low|medium|high), 비우면 보내지 않는다
GEMINI_REASONING_EFFORT=low

# OpenAI 호환 서버 (기본: 로컬 Ollama). 주소를 기본값 그대로 두면 Gemini·Claude 키가 있을 때 건너뛴다
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:32b
# OPENAI_MODEL이 첫 글자 전에 실패하면 대신 답할 같은 주소의 모델. 비우면 없음
OPENAI_FALLBACK_MODEL=
# Claude(Anthropic API): 위 모델이 모두 첫 글자 전에 실패하면 마지막으로 답한다. 비우면 쓰지 않는다.
# CLAUDE_API_KEY라는 이름도 된다. Console에서 만든 API 키(sk-ant-api03-…)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# 추론 강도(low | medium | high). 낮을수록 빠르고 싸다
ANTHROPIC_EFFORT=low
# legacy(기본): 검색 + 품질 게이트 재호출 / direct: 지식베이스 전체 + 1회 호출 스트리밍
# 바꾸기 전에 backend/evals로 두 방식을 비교한다 (evals/README.md)
ANSWER_PIPELINE=legacy
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
# OPENAI_* 서버에 보내는 temperature (Gemini·Claude에는 보내지 않는다)
LLM_TEMPERATURE=0.4
LLM_MAX_OUTPUT_TOKENS=1200
# 스트리밍 응답에 토큰 사용량 요청(stream_options). 지원하지 않는 서버면 false
LLM_STREAM_USAGE=true
# OPENAI_* 서버가 생각하는 모델일 때의 추론 강도(reasoning_effort, 예: low). 비우면 보내지 않는다.
# 생각 토큰도 출력 한도에 들어가므로 켜면 LLM_MAX_OUTPUT_TOKENS를 4096쯤으로 올린다
LLM_REASONING_EFFORT=
# direct 파이프라인이 모델에 다시 보내는 직전 질문·답변 쌍 수
CHAT_HISTORY_TURNS=3
ANSWER_TIME_BUDGET_SECONDS=90
RAG_TOP_K=4
RAG_MODE=lexical
RAG_VECTOR_WEIGHT=0.7
RAG_LEXICAL_WEIGHT=0.3
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
RAG_EMBEDDING_API_KEY=ollama
DATABASE_URL=
ANSWER_QUALITY_MODE=balanced

FIREBASE_CREDENTIALS_PATH=../serviceAccountKey.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
ALLOWED_ORIGINS=http://localhost:5173,https://www.309designlab.com,https://309designlab.com
ALLOWED_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?309designlab\.com$|^http://(localhost|127\.0\.0\.1)(:\d+)?$
KNOWLEDGE_PACK_PATH=../knowledge_base/309_knowledge_pack.json
# 비공개 옵시디언 노트 (docs/obsidian-notes.md). 운영: 비공개 GitHub 저장소 + 읽기 전용 토큰
NOTES_GITHUB_REPO=
NOTES_GITHUB_TOKEN=
NOTES_GITHUB_REF=main
# 로컬 개발: 볼트 폴더를 직접 읽는다 (NOTES_GITHUB_REPO가 비어 있을 때)
NOTES_DIR=
# 저장소·폴더 안에서 읽을 하위 폴더
NOTES_SUBDIR=309-persona
# direct 프롬프트에 넣는 노트 분량(글자). 넘치면 프로젝트·경력·사례 노트부터 넣고 나머지는 뺀다
NOTES_MAX_CHARS=60000
MAX_SESSION_QUESTIONS=5
SESSION_WINDOW_MINUTES=30
# 같은 IP의 질문·새 세션 수 제한(IP_WINDOW_MINUTES 동안). 서버 메모리에만 있어 재배포하면 초기화된다
MAX_IP_QUESTIONS=30
MAX_IP_SESSIONS=20
IP_WINDOW_MINUTES=60
# 앱 앞단에서 X-Forwarded-For를 덧붙이는 프록시 수(Render 1, staging의 nginx 1). 0이면 헤더를 무시
TRUSTED_PROXY_HOPS=1
ADMIN_ALLOWED_EMAILS=me@example.com
# 비어 있으면 대시보드 접근이 모두 막힌다. 관리자 Firebase 계정이 이메일 인증을 마쳤다면 true 권장
ADMIN_REQUIRE_EMAIL_VERIFIED=false
ENVIRONMENT=local

